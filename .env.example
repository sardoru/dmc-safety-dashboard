# ─────────────────────────────────────────────────────────────────────────────
# Core Downtown Memphis Safety Dashboard — environment
#
# The app runs in DEMO MODE (sample data, role switcher, no login) until the
# Supabase vars below are set. Add the VITE_* vars to the client build and the
# unprefixed vars as Vercel Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (Vite, must be VITE_ prefixed) ───────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Production origin used in magic-link emails (no trailing slash). Defaults to
# window.location.origin if unset.
VITE_SITE_URL=https://dmc-safety-dashboard.vercel.app

# Memphis PD live scanner (Broadcastify feed 215). Plays INLINE by default from
# the feed's CORS-open Icecast mount (https://broadcastify.cdnstream1.com/<id>).
# Set VITE_BROADCASTIFY_STREAM_URL only to OVERRIDE the mount (e.g. a Premium
# relay URL). If the stream fails to play, the UI falls back to the popup player.
VITE_BROADCASTIFY_FEED_ID=215
VITE_BROADCASTIFY_STREAM_URL=

# Self-hosted radio transcription bridge (optional). Leave VITE_RADIO_WS_URL
# empty to disable it — the app only connects when it is set.
VITE_RADIO_WS_URL=
VITE_RADIO_HTTP_URL=

# Brand imagery (generated with Higgsfield) is served through Vercel Image
# Optimization in production (vercel.json → images). Set to "off" to load the
# originals straight from the CDN instead.
VITE_IMAGE_OPTIMIZER=

# ── Server (Vercel functions — DO NOT prefix with VITE_) ─────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Production origin used by server functions for WebAuthn + email links.
SITE_URL=https://dmc-safety-dashboard.vercel.app

# Comma-separated emails auto-granted the 'admin' role on first login.
ADMIN_EMAILS=sardoru@gmail.com

# OpenAI — dictation, "Organize my notes" report structuring, the shift
# briefing, and the GPT-Live voice line used when no ElevenLabs agent is set
# (/api/live-session creates it from the browser's WebRTC offer, so the browser
# never holds a key).
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Responses model the interviewer delegates to (holds the file_incident_report
# tool); gpt-5.6-luna is the cost-saver. Effort: none | minimal | low | medium | high.
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
OPENAI_LIVE_BACKEND_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Text models for report structuring and the spoken shift briefing. Each falls
# back through OPENAI_TEXT_MODEL → gpt-5.6-luna → gpt-4.1-mini, so leaving them
# empty is fine.
OPENAI_EXTRACT_MODEL=
OPENAI_BRIEFING_MODEL=
OPENAI_TEXT_MODEL=

# ElevenLabs — Eleven v4 text-to-speech for spoken alerts, shift briefings,
# report read-backs, "Listen" buttons and the guided form's voice prompts.
# Without a key the app falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
# Used only if the account/endpoint rejects v4 (speech keeps working).
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2
# Default voice ("George"); each user can pick another voice in Settings.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# The voice interviewer: an ElevenLabs agent speaking with Eleven v4. Create or
# update it with `npx tsx scripts/voice-agent.ts` and paste the printed id here.
ELEVENLABS_AGENT_ID=
# Used by scripts/voice-agent.ts: the agent's voice model and brain.
# eleven_v4_turbo answers ~0.3 s sooner.
ELEVENLABS_AGENT_TTS_MODEL=eleven_v4
ELEVENLABS_AGENT_LLM=gpt-5.6-terra

# Resend — branded magic-link + invite emails. The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Core Downtown Memphis Safety <safety@901safety.com>
# Optional: where replies go. The sending domain has no inbox, so without this a reply bounces.
# Leave it empty when the reply relay below is on — replies then go to EMAIL_FROM and are relayed.
EMAIL_REPLY_TO=
# Reply relay (api/inbound-email): Resend receives mail for the sending domain and forwards it to
# INBOUND_FORWARD_TO (comma-separated; server-only, never shown to anyone). The team answers through
# reply+<id>@<domain>, so their own address stays hidden. RESEND_WEBHOOK_SECRET is the signing secret of
# the Resend webhook for "email.received" → https://www.901safety.com/api/inbound-email.
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=

# Supabase "Send Email" auth hook secret (format: v1,whsec_xxxxx). Generated in
# Supabase Dashboard → Authentication → Hooks → Send Email Hook.
SEND_EMAIL_HOOK_SECRET=

# WebAuthn / passkeys. RP_ID is the bare domain (no scheme/port); RP_ORIGIN is
# the full origin. Defaults are derived from the request host if unset.
RP_ID=dmc-safety-dashboard.vercel.app
RP_ORIGIN=https://dmc-safety-dashboard.vercel.app
