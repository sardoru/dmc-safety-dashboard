{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/cron/invites", "schedule": "*/15 * * * *" }],
  "images": {
    "sizes": [256, 384, 640, 828, 1080, 1280, 1600, 1920, 2560],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "d8j0ntlcm91z4.cloudfront.net"
      }
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "dmc-safety-dashboard.vercel.app" }],
      "destination": "https://www.901safety.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/how-to-report", "destination": "/how-to-report.html" },
    { "source": "/how-to-join", "destination": "/how-to-join.html" },
    { "source": "/in-30-seconds", "destination": "/in-30-seconds.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/live", "destination": "/live.html" },
    { "source": "/((?!api/|assets/|_vercel/).*)", "destination": "/index.html" }
  ]
}
